# SignalGraph environment variables
# Copy to .env and fill in values as needed.
# Do not commit secrets.

# Primary data source for the initial research phase.
SIGNALGRAPH_PRIMARY_PLATFORM=kalshi

# Kalshi Trade API base URL (public market data does not require auth).
# Production (documented): https://api.elections.kalshi.com/trade-api/v2
# Alternative production host: https://external-api.kalshi.com/trade-api/v2
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# Optional: Kalshi API credentials for authenticated endpoints
# (portfolio, private websockets, trading). Public market listing and
# candlestick history used in this repo do not require these.
# Create keys at https://kalshi.com (Account → API Keys).
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Polymarket (scaffolding only — not the initial source)
POLYMARKET_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com

# Local data directories (override if needed)
SIGNALGRAPH_DATA_DIR=data
SIGNALGRAPH_RAW_DIR=data/raw
SIGNALGRAPH_NORMALIZED_DIR=data/normalized
SIGNALGRAPH_PROCESSED_DIR=data/processed

# HTTP client
SIGNALGRAPH_HTTP_TIMEOUT_SECONDS=30
SIGNALGRAPH_HTTP_MAX_RETRIES=3
